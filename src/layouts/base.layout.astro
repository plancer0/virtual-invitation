---
import "../styles/global.css";
import type { Palette } from "../types/palette";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { invitation } from "../config/invitation";
import { checkPalette, paletteToStyle, resolvePalette } from "../lib/palette";

interface Props {
  title: string;
  /** Idioma del documento. */
  lang?: string;
  /** Clases para el <body>: la portada anula el centrado del body global. */
  bodyClass?: string;
  /** Permite que una pagina use otra paleta que la de la invitacion. */
  palette?: Palette;
}

const { title, lang = "es", palette = invitation.palette, bodyClass } = Astro.props;

// Las variables van en el <html> y no en el <body>: el fondo de la pagina se
// pinta sobre el elemento raiz, y asi tambien lo ven las capas de la
// transicion de vista, que se montan fuera del <body>.
const paletteStyle = paletteToStyle(palette);

// Aviso, no error: una paleta con poco contraste compila igual pero deja
// decoraciones invisibles. Se avisa una sola vez, en el build.
if (import.meta.env.PROD) {
  for (const aviso of checkPalette(resolvePalette(palette))) console.warn(aviso);
}
---

<!-- Cabecera comun a portada e invitacion: fuentes, iconos y el router de
     transiciones. Las dos paginas deben cargar el mismo ClientRouter para que
     la navegacion entre ellas se anime. -->
<html lang={lang} style={paletteStyle}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--baskervville" preload />
    <Font cssVariable="--baskervville-sc" preload />
    <Font cssVariable="--meaculpa" preload />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
