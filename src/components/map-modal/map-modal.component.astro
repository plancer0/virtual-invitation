---
interface Props {
  googleMapsUrl: string;
  appleMapsUrl: string;
  wazeUrl: string;
  uberUrl: string;
}

const { googleMapsUrl, appleMapsUrl, wazeUrl, uberUrl } = Astro.props;
---

<button
  id="map-modal-trigger"
  type="button"
  aria-haspopup="dialog"
  aria-expanded="false"
  class="inline-flex items-center justify-center whitespace-nowrap bg-accent text-on-accent px-[clamp(16px,5vw,24px)] py-[clamp(8px,2.4vw,12px)] rounded-full shadow-lg font-baskervville text-[clamp(13px,3.6vw,16px)] tracking-wide hover:opacity-90 transition-opacity"
>
  Cómo llegar
</button>

<div
  id="map-modal-backdrop"
  class="fixed inset-0 z-50 flex items-center justify-center invisible opacity-0 bg-black/40 backdrop-blur-sm px-4"
  role="presentation"
>
  <div
    id="map-modal-panel"
    class="w-full max-w-[360px] rounded-[24px] border border-detail bg-base p-[clamp(20px,6vw,32px)] flex flex-col gap-4 items-center"
    role="dialog"
    aria-modal="true"
    aria-labelledby="map-modal-title"
  >
    <h2
      id="map-modal-title"
      class="font-baskervville text-ink text-[clamp(20px,5vw,28px)] text-center"
    >
      ¿Cómo quieres llegar?
    </h2>
    <div class="flex flex-col gap-3 w-full">
      <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="map-option"
        >Google Maps</a
      >
      <a href={appleMapsUrl} target="_blank" rel="noopener noreferrer" class="map-option"
        >Apple Maps</a
      >
      <a href={wazeUrl} target="_blank" rel="noopener noreferrer" class="map-option">Waze</a>
      <a href={uberUrl} target="_blank" rel="noopener noreferrer" class="map-option">Uber</a>
    </div>
    <button
      id="map-modal-close"
      type="button"
      class="text-ink underline text-[clamp(14px,4vw,16px)] font-baskervville mt-1"
    >
      Cerrar
    </button>
  </div>
</div>

<style>
  .map-option {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 14px;
    border-radius: 9999px;
    border: 1px solid var(--color-detail);
    color: var(--color-ink);
    font-family: var(--font-baskervville);
    font-size: clamp(14px, 4vw, 18px);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .map-option:hover,
  .map-option:focus-visible {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }
</style>

<script>
  import gsap from "gsap";

  const trigger = document.getElementById("map-modal-trigger");
  const backdrop = document.getElementById("map-modal-backdrop");
  const panel = document.getElementById("map-modal-panel");
  const closeBtn = document.getElementById("map-modal-close");

  if (trigger && backdrop && panel && closeBtn) {
    // Move the overlay to a direct child of <body> so a `transform` on any
    // ancestor (e.g. a scroll-reveal animation) can't hijack its
    // `position: fixed` containing block and mis-place it off-viewport.
    document.body.appendChild(backdrop);

    gsap.set(backdrop, { autoAlpha: 0 });
    gsap.set(panel, { autoAlpha: 0, y: 24, scale: 0.92 });

    let isOpen = false;

    const openModal = () => {
      if (isOpen) return;
      isOpen = true;
      document.documentElement.style.overflow = "hidden";
      gsap
        .timeline()
        .to(backdrop, { autoAlpha: 1, duration: 0.25, ease: "power1.out" })
        .to(
          panel,
          { autoAlpha: 1, y: 0, scale: 1, duration: 0.35, ease: "back.out(1.6)" },
          "-=0.1",
        );
      trigger.setAttribute("aria-expanded", "true");
    };

    const closeModal = () => {
      if (!isOpen) return;
      isOpen = false;
      document.documentElement.style.overflow = "";
      gsap
        .timeline()
        .to(panel, { autoAlpha: 0, y: 16, scale: 0.94, duration: 0.2, ease: "power1.in" })
        .to(backdrop, { autoAlpha: 0, duration: 0.2, ease: "power1.in" }, "-=0.1");
      trigger.setAttribute("aria-expanded", "false");
    };

    trigger.addEventListener("click", openModal);
    closeBtn.addEventListener("click", closeModal);
    backdrop.addEventListener("click", (event) => {
      if (event.target === backdrop) closeModal();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeModal();
    });
  }
</script>
