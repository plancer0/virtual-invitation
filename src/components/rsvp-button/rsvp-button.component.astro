---
interface Props {
  phoneNumber: string;
  message?: string;
}

const {
  phoneNumber,
  message = "Hola, confirmo mi asistencia a los 15 años de Rachell",
} = Astro.props;

const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
---

<a
  id="rsvp-button"
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed z-40 left-1/2 -translate-x-1/2 bottom-[calc(clamp(12px,4vw,24px)+env(safe-area-inset-bottom))] inline-flex items-center justify-center whitespace-nowrap bg-[#3A2A5C] text-[#FAF7F0] px-[clamp(22px,6vw,32px)] py-[clamp(12px,3vw,16px)] rounded-full shadow-lg font-baskervville text-[clamp(13px,3.6vw,18px)] tracking-wide hover:bg-[#4B2882] transition-colors"
>
  Confirmar asistencia
</a>
