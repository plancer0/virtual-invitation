---
// Aqui solo esta el boton. El <audio> y toda la logica viven en
// base.layout.astro, porque la reproduccion tiene que poder arrancar desde el
// toque en el sobre, y ese toque ocurre en la portada, donde este componente
// no se monta.
---

<button
  id="music-toggle"
  type="button"
  aria-label="Reproducir música"
  aria-pressed="false"
  class="fixed z-40 top-[clamp(12px,4vw,24px)] right-[clamp(12px,4vw,24px)] w-[44px] h-[44px] flex items-center justify-center rounded-full bg-accent text-on-accent shadow-lg hover:opacity-90 transition-opacity"
>
  <svg
    id="music-icon-play"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="currentColor"
  >
    <path d="M8 5v14l11-7z"></path>
  </svg>
  <svg
    id="music-icon-pause"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="currentColor"
    class="hidden"
  >
    <path d="M6 5h4v14H6zM14 5h4v14h-4z"></path>
  </svg>
</button>
