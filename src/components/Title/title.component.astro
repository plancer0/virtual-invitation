---
interface Props {
    color?: string;
    fontSize?: string;
    fontFamily?: string;
    class?: string;
}

const { color="#B8860B", fontSize="40px", fontFamily="var(--font-baskervville)", class: className} = Astro.props;
---

<h1 class:list={[className]}>
    <slot />
</h1>

<style define:vars={{color, fontSize, fontFamily}}>
    h1 {
        color: var(--color);
        font-size: var(--fontSize);
        font-family: var(--fontFamily);
        text-align: center;
    }
</style>