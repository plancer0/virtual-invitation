---
interface Props {
  class?: string;
  color?: string;
}

const { class: className, color = "#8D6FAE" } = Astro.props;
---

<div class:list={["flex gap-4", className]}>
  <!-- Regalo -->
  <svg
    viewBox="0 0 24 24"
    class="w-[clamp(24px,7vw,32px)] h-[clamp(24px,7vw,32px)]"
    fill="none"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect x="3" y="9" width="18" height="12" rx="1.5" stroke={color} stroke-width="1.5" />
    <path d="M3 13H21" stroke={color} stroke-width="1.5" />
    <path d="M12 9V21" stroke={color} stroke-width="1.5" />
    <path
      d="M12 9C12 9 8 9 8 6C8 4.5 9.2 3.5 10.5 3.5C12 3.5 12 6 12 9Z"
      stroke={color}
      stroke-width="1.5"
      stroke-linejoin="round"
    />
    <path
      d="M12 9C12 9 16 9 16 6C16 4.5 14.8 3.5 13.5 3.5C12 3.5 12 6 12 9Z"
      stroke={color}
      stroke-width="1.5"
      stroke-linejoin="round"
    />
  </svg>
  <!-- Sobre -->
  <svg
    viewBox="0 0 24 24"
    class="w-[clamp(24px,7vw,32px)] h-[clamp(24px,7vw,32px)]"
    fill="none"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect x="2.5" y="5" width="19" height="14" rx="1.5" stroke={color} stroke-width="1.5" />
    <path d="M3 6L12 13L21 6" stroke={color} stroke-width="1.5" stroke-linejoin="round" />
  </svg>
</div>
