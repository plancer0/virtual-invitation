---
interface Props {
    date: Date;
}

const {date = new Date()} = Astro.props;
---

<div class="flex flex-nowrap justify-center items-center w-full h-auto py-2">
    <span class="date-framed text-[#3A2A5C] justify-center items-center font-baskervville border-b-[1px] capitalize flex border-t-[1px] text-[clamp(13px,5vw,40px)] text-center whitespace-nowrap w-[clamp(60px,34%,200px)] h-[clamp(34px,9vw,62px)] shrink-0">
        {date.toLocaleDateString('es-ES', {weekday: 'long'})}
    </span>
    <div class="flex flex-col w-[clamp(52px,22%,122px)] justify-center items-center text-[#3A2A5C] shrink-0">
        <span class="text-[clamp(24px,8vw,56px)] font-baskervville">{date.getDate()}</span>
        <span class="text-[clamp(10px,3vw,20px)] font-baskervville capitalize">
            {date.toLocaleDateString('es-ES', {month: 'short'})}
        </span>
    </div>
    <span class="text-[#3A2A5C] justify-center items-center font-baskervville-sc w-[clamp(60px,34%,200px)] h-[clamp(34px,9vw,62px)] flex border-b-[1px] border-t-[1px] text-[clamp(13px,5vw,40px)] text-center whitespace-nowrap shrink-0">{date.toLocaleTimeString('en-uS', {hour: 'numeric', minute: '2-digit', hour12: true})}</span>
</div>

