---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const roles = ["a", "b", "c", "d"];
---

<div
  class:list={["polaroid-stage relative w-full flex justify-center items-center", className]}
>
  {
    roles.map((role) => (
      <div class="polaroid-anchor">
        <div class="polaroid-card" data-role={role}>
          <div class="polaroid-photo">
            <svg
              viewBox="0 0 48 48"
              class="w-[30%] h-[30%]"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <rect x="4" y="8" width="40" height="32" rx="3" stroke="#b1a0c7" stroke-width="2" />
              <circle cx="16" cy="19" r="4" stroke="#b1a0c7" stroke-width="2" />
              <path
                d="M4 33L16 22L26 30L34 24L44 33"
                stroke="#b1a0c7"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span>Foto</span>
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  .polaroid-stage {
    /* Alto para dos filas de tarjetas una vez desplegadas. */
    height: clamp(400px, 110vw, 580px);
  }

  .polaroid-anchor {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  /* Orden de apilado mientras estan juntas: la primera arriba del todo. */
  .polaroid-anchor:nth-child(1) {
    z-index: 4;
  }
  .polaroid-anchor:nth-child(2) {
    z-index: 3;
  }
  .polaroid-anchor:nth-child(3) {
    z-index: 2;
  }
  .polaroid-anchor:nth-child(4) {
    z-index: 1;
  }

  .polaroid-card {
    /* El minimo es bajo a proposito: al desplegarse en 2x2 el conjunto ocupa
       dos anchos de tarjeta, asi que por debajo de 375px deben encoger para
       no salirse del marco. */
    width: clamp(104px, 37vw, 210px);
    aspect-ratio: 4 / 5;
    background: #ffffff;
    padding: clamp(10px, 2.4vw, 14px) clamp(10px, 2.4vw, 14px) clamp(34px, 8vw, 44px);
    box-shadow: 0 12px 28px rgba(64, 56, 72, 0.22);
    border-radius: 4px;
  }

  .polaroid-photo {
    width: 100%;
    height: 100%;
    background: #d8d3dd;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .polaroid-photo span {
    font-family: var(--font-baskervville-sc);
    color: #8d6fae;
    font-size: clamp(11px, 3vw, 14px);
    letter-spacing: 0.04em;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // x/y en porcentaje son relativos al propio tamano de la tarjeta, asi que
  // el despliegue escala solo con el clamp del ancho.
  const layout = {
    a: { from: { rotate: -4, y: "-1%" }, to: { x: "-50%", y: "-52%", rotate: -8 } },
    b: { from: { rotate: 3, y: "1%" }, to: { x: "50%", y: "-52%", rotate: 6 } },
    c: { from: { rotate: -2, y: "3%" }, to: { x: "-50%", y: "52%", rotate: -5 } },
    d: { from: { rotate: 4, y: "5%" }, to: { x: "50%", y: "52%", rotate: 8 } },
  };

  document.querySelectorAll<HTMLElement>(".polaroid-stage").forEach((stage) => {
    const timeline = gsap.timeline({
      scrollTrigger: {
        trigger: stage,
        start: "top 80%",
        end: "top 20%",
        scrub: 0.6,
      },
    });

    Object.entries(layout).forEach(([role, config]) => {
      const card = stage.querySelector<HTMLElement>(`[data-role="${role}"]`);
      if (!card) return;
      gsap.set(card, config.from);
      timeline.to(card, { ...config.to, ease: "none" }, 0);
    });
  });
</script>
