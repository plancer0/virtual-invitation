---
import { Image } from "astro:assets";
import type { PhotoConfig } from "../../types/invitation";

interface Props {
  class?: string;
  /** Cuatro fotos, en el orden en que se despliegan. */
  photos: PhotoConfig[];
}

const { class: className, photos } = Astro.props;

// Al desplegarse: a arriba-izq, b arriba-der, c abajo-izq, d abajo-der.
const roles = ["a", "b", "c", "d"];

const fotos = photos.slice(0, 4).map((foto, i) => ({
  role: roles[i],
  src: foto.src,
  // `position` mueve el encuadre dentro del marco; `zoom` acerca mas alla del
  // encuadre de object-cover y el marco recorta, porque lleva overflow oculto.
  pos: foto.position ?? "object-center",
  zoom: foto.zoom ?? "",
}));
---

<div class:list={["polaroid-stage relative w-full flex justify-center items-center", className]}>
  {
    fotos.map(({ role, src, pos, zoom }) => (
      <div class="polaroid-anchor">
        <div class="polaroid-card" data-role={role}>
          <div class="polaroid-photo">
            {/* object-cover recorta al centro: las cuatro fotos tienen
                proporciones distintas y asi todas llenan el marco. */}
            <Image
              src={src}
              width={520}
              alt=""
              class:list={["w-full h-full object-cover", pos, zoom]}
            />
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  .polaroid-stage {
    /* Alto para dos filas de tarjetas una vez desplegadas. Debe seguir al
       ancho de tarjeta: el despliegue ocupa 2.04 veces su altura. */
    height: clamp(430px, 132vw, 730px);
  }

  .polaroid-anchor {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  /* Orden de apilado mientras estan juntas: la primera arriba del todo. */
  .polaroid-anchor:nth-child(1) {
    z-index: 4;
  }
  .polaroid-anchor:nth-child(2) {
    z-index: 3;
  }
  .polaroid-anchor:nth-child(3) {
    z-index: 2;
  }
  .polaroid-anchor:nth-child(4) {
    z-index: 1;
  }

  .polaroid-card {
    /* El minimo es bajo a proposito: al desplegarse en 2x2 el conjunto ocupa
       dos anchos de tarjeta, asi que por debajo de 375px deben encoger para
       no salirse del marco. */
    width: clamp(104px, 37vw, 210px);
    /* El alto lo marca la foto, no la tarjeta: si se fija aqui, la proporcion
       del hueco de la foto cambia con cada breakpoint (los paddings usan
       clamps distintos) y el recorte sale distinto en cada dispositivo. */
    background: #ffffff;
    padding: clamp(10px, 2.4vw, 14px) clamp(10px, 2.4vw, 14px) clamp(34px, 8vw, 44px);
    /* Difuminado corto a proposito: el coste de pintar una sombra crece con el
       radio, y a 28px era de lo mas caro de la pagina en movil. */
    box-shadow: 0 4px 10px rgba(64, 56, 72, 0.26);
    border-radius: 4px;
    /* Promueve cada tarjeta a su propia capa: la sombra difuminada se rasteriza
       una sola vez y el scroll solo compone, en vez de repintar 4 sombras en
       cada frame. Es lo que hacia que se trabara en movil. */
    will-change: transform;
    backface-visibility: hidden;
  }

  .polaroid-photo {
    width: 100%;
    /* Proporcion fija: identica en todos los dispositivos. Mas alta que antes
       para que las fotos verticales pierdan menos al recortarse. */
    aspect-ratio: 2 / 3;
    background: #d8d3dd;
    /* overflow oculto para que object-cover recorte dentro del marco. */
    overflow: hidden;
  }

  .polaroid-photo span {
    font-family: var(--font-baskervville-sc);
    color: #8d6fae;
    font-size: clamp(11px, 3vw, 14px);
    letter-spacing: 0.04em;
  }

  /* Despliegue ligado al scroll, pero en CSS: lo ejecuta el compositor, fuera
     del hilo principal, asi que no compite con el scroll del navegador. Es la
     diferencia con hacerlo por JavaScript, que era lo que trababa en movil.
     Donde no haya soporte, el script de abajo hace el despliegue de una vez. */
  @supports (animation-timeline: view()) {
    .polaroid-card {
      /* En propiedades separadas: el atajo `animation: linear both` es
         invalido y el navegador descarta la declaracion entera, dejando
         fill en none y provocando un salto fuera del rango. */
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: entry 15% cover 40%;
    }

    .polaroid-card[data-role="a"] {
      animation-name: desplegar-a;
    }
    .polaroid-card[data-role="b"] {
      animation-name: desplegar-b;
    }
    .polaroid-card[data-role="c"] {
      animation-name: desplegar-c;
    }
    .polaroid-card[data-role="d"] {
      animation-name: desplegar-d;
    }

    @media (prefers-reduced-motion: reduce) {
      .polaroid-card {
        animation: none;
      }
      .polaroid-card[data-role="a"] {
        transform: translate(-50%, -52%) rotate(-8deg);
      }
      .polaroid-card[data-role="b"] {
        transform: translate(50%, -52%) rotate(6deg);
      }
      .polaroid-card[data-role="c"] {
        transform: translate(-50%, 52%) rotate(-5deg);
      }
      .polaroid-card[data-role="d"] {
        transform: translate(50%, 52%) rotate(8deg);
      }
    }
  }

  @keyframes desplegar-a {
    from {
      transform: translate(0, -1%) rotate(-4deg);
    }
    to {
      transform: translate(-50%, -52%) rotate(-8deg);
    }
  }

  @keyframes desplegar-b {
    from {
      transform: translate(0, 1%) rotate(3deg);
    }
    to {
      transform: translate(50%, -52%) rotate(6deg);
    }
  }

  @keyframes desplegar-c {
    from {
      transform: translate(0, 3%) rotate(-2deg);
    }
    to {
      transform: translate(-50%, 52%) rotate(-5deg);
    }
  }

  @keyframes desplegar-d {
    from {
      transform: translate(0, 5%) rotate(4deg);
    }
    to {
      transform: translate(50%, 52%) rotate(8deg);
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  // Si el navegador soporta animaciones ligadas al scroll, el despliegue lo
  // resuelve el CSS en el compositor y aqui no hay nada que hacer.
  const scrollDrivenCss = CSS.supports("animation-timeline", "view()");

  gsap.registerPlugin(ScrollTrigger);

  // En movil, mostrar u ocultar la barra del navegador cambia el alto del
  // viewport y dispara un refresh de ScrollTrigger a mitad del scroll: es la
  // causa tipica del tiron. Con esto se ignora ese cambio de alto.
  ScrollTrigger.config({ ignoreMobileResize: true });

  const sinMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // x/y en porcentaje son relativos al propio tamano de la tarjeta, asi que
  // el despliegue escala solo con el clamp del ancho.
  const layout = {
    a: { from: { rotate: -4, y: "-1%" }, to: { x: "-50%", y: "-52%", rotate: -8 } },
    b: { from: { rotate: 3, y: "1%" }, to: { x: "50%", y: "-52%", rotate: 6 } },
    c: { from: { rotate: -2, y: "3%" }, to: { x: "-50%", y: "52%", rotate: -5 } },
    d: { from: { rotate: 4, y: "5%" }, to: { x: "50%", y: "52%", rotate: 8 } },
  };

  if (!scrollDrivenCss)
  document.querySelectorAll<HTMLElement>(".polaroid-stage").forEach((stage) => {
    const cards = Object.entries(layout)
      .map(([role, config]) => ({
        el: stage.querySelector<HTMLElement>(`[data-role="${role}"]`),
        config,
      }))
      .filter((c): c is { el: HTMLElement; config: (typeof layout)["a"] } => c.el !== null);

    // Sin animacion: se dejan ya desplegadas.
    if (sinMovimiento) {
      cards.forEach(({ el, config }) => gsap.set(el, config.to));
      return;
    }

    cards.forEach(({ el, config }) => gsap.set(el, { ...config.from, force3D: true }));

    // Se dispara una sola vez al entrar en pantalla y corre en su propio
    // tiempo. Antes iba atada al scroll con `scrub`, lo que obligaba a
    // recalcular las cuatro tarjetas en cada frame mientras el usuario
    // deslizaba: eso competia con el scroll del navegador y lo trababa.
    ScrollTrigger.create({
      trigger: stage,
      start: "top 75%",
      once: true,
      onEnter: () => {
        const tl = gsap.timeline({
          onComplete: () => {
            // Terminada la animacion se libera la capa extra de cada tarjeta.
            cards.forEach(({ el }) => (el.style.willChange = "auto"));
          },
        });
        cards.forEach(({ el, config }, i) => {
          tl.to(el, { ...config.to, duration: 0.9, ease: "power3.out", force3D: true }, i * 0.08);
        });
      },
    });
  });
</script>
