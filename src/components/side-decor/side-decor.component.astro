---
import { Image } from "astro:assets";
import { asset } from "../../lib/assets";
// En WebP y no en SVG: el vectorial pesaba 1 MB y traia 2239 trazos que el
// navegador debe interpretar en cada pintado, para mostrarse a 130px.





const flor = asset("flor");
const mariposas = asset("mariposas");
const rama = asset("rama");
const rosas = asset("rosas");
const globos = asset("globos");
const mariposa = asset("mariposa");

type Kind = "flor" | "mariposas" | "rama" | "rosas" | "globos" | "mariposa";

interface Props {
  class?: string;
  /** Refleja la decoracion para el lado opuesto. */
  flip?: boolean;
  kind?: Kind;
  [key: string]: unknown;
}

const { class: className, flip = false, kind = "flor", ...rest } = Astro.props;

// Se usan como imagen, no inline: son miles de trazos y meterlos en el DOM
// penalizaria el scroll en movil. Los colores van horneados en cada archivo,
// recoloreados al matiz de la paleta a partir de los originales.
const sources = {
  flor: { src: flor, width: 941, height: 1672, alt: "" },
  mariposas: { src: mariposas, width: 520, height: 816, alt: "" },
  rama: { src: rama, width: 578, height: 812, alt: "" },
  rosas: { src: rosas, width: 997, height: 1034, alt: "" },
  globos: { src: globos, width: 1000, height: 1284, alt: "" },
  mariposa: { src: mariposa, width: 700, height: 521, alt: "" },
} satisfies Record<Kind, { src: ImageMetadata; width: number; height: number; alt: string }>;

const imagen = sources[kind];
---

<Image
  src={imagen.src}
  width={imagen.width}
  height={imagen.height}
  alt=""
  aria-hidden="true"
  class:list={[className, flip && "-scale-x-100"]}
  {...rest}
/>
