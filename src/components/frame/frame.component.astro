---
interface Props {
  gap?: string;
  padding?: string;
  border?: string;
  background?: string;
  width?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  gap = "10px",
  padding = "1rem",
  border = "1px solid #b1a0c7",
  background = "#E8E1EF",
  width = "100%",
  class: className,
  ...rest
} = Astro.props;
---

<div class:list={['frame', className]} {...rest}>
  <slot />
</div>

<style define:vars={{ gap, padding, border, background, width }}>
  .frame {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    padding: var(--padding);
    border: var(--border);
    background: var(--background);
    background-image: url('../../Images/noise-soft.png');
    /* background-size: 300px; */
    /* Solo arriba: abajo el marco sigue recto en lugar de cerrarse en curva. */
    border-radius: 99999px 99999px 0 0;
    height: auto;
    width: var(--width);
  }
</style>
