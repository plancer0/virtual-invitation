---
import { GOOGLE_CALENDAR_URL } from "../../lib/event";

interface Props {
  date: Date;
  class?: string;
}

const { date, class: className } = Astro.props;

const year = date.getFullYear();
const month = date.getMonth();
const highlightedDay = date.getDate();

const weekdayLabels = ["D", "L", "M", "M", "J", "V", "S"];

const firstWeekday = new Date(year, month, 1).getDay();
const daysInMonth = new Date(year, month + 1, 0).getDate();

const cells: (number | null)[] = [
  ...Array(firstWeekday).fill(null),
  ...Array.from({ length: daysInMonth }, (_, i) => i + 1),
];
while (cells.length % 7 !== 0) cells.push(null);

const monthLabel = date.toLocaleDateString("es-ES", { month: "long", year: "numeric" });
---

<div class:list={["calendar w-full max-w-[320px] flex flex-col gap-3 items-center", className]}>
  <span class="font-baskervville-sc text-ink text-[clamp(18px,5vw,24px)] capitalize">
    {monthLabel}
  </span>
  <div class="grid grid-cols-7 gap-[clamp(4px,1.5vw,8px)] w-full">
    {
      weekdayLabels.map((label) => (
        <span class="flex items-center justify-center font-baskervville-sc text-accent text-[clamp(11px,3vw,14px)] aspect-square">
          {label}
        </span>
      ))
    }
    {
      cells.map((day) =>
        day === highlightedDay ? (
          <span class="day-slot relative flex items-center justify-center aspect-square">
            <button
              type="button"
              class="day-button"
              data-google-url={GOOGLE_CALENDAR_URL}
              aria-label={`Agregar el ${day} a mi calendario`}
            >
              {day}
            </button>
            <span class="sparkle sparkle--1" aria-hidden="true" />
            <span class="sparkle sparkle--2" aria-hidden="true" />
            <span class="sparkle sparkle--3" aria-hidden="true" />
            <span class="sparkle sparkle--4" aria-hidden="true" />
            <span class="sparkle sparkle--5" aria-hidden="true" />
          </span>
        ) : (
          <span class="flex items-center justify-center rounded-full font-baskervville text-[clamp(12px,3.6vw,16px)] aspect-square text-ink">
            {day ?? ""}
          </span>
        ),
      )
    }
  </div>
  <button type="button" class="calendar-hint" data-google-url={GOOGLE_CALENDAR_URL}>
    Toca el día para agendarlo
  </button>
</div>

<style>
  .day-slot {
    /* Los destellos se salen de la celda; que no los recorte la rejilla. */
    overflow: visible;
  }

  /* Halo que respira detras del dia. */
  .day-slot::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 260%;
    height: 260%;
    transform: translate(-50%, -50%);
    border-radius: 9999px;
    pointer-events: none;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 32%, transparent) 0%,
      color-mix(in srgb, var(--color-accent) 14%, transparent) 45%,
      transparent 70%
    );
    animation: day-halo 2.4s ease-in-out infinite;
  }

  .day-button {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 9999px;
    color: var(--color-on-accent);
    font-family: var(--font-baskervville);
    font-size: clamp(12px, 3.6vw, 16px);
    cursor: pointer;
    border: none;
    /* Banda clara que barre el circulo: el brillo se anima moviendo el
       fondo, no con overflow, para no recortar el area tactil de ::before. */
    background-image: linear-gradient(
      115deg,
      var(--color-accent) 0%,
      var(--color-accent) 40%,
      var(--color-accent-soft) 50%,
      var(--color-accent) 60%,
      var(--color-accent) 100%
    );
    background-size: 300% 100%;
    /* El barrido de brillo era una animacion infinita de background-position,
       que obliga a repintar en cada frame. Se deja como degradado fijo. */
    background-position: 50% 0;
  }

  @keyframes day-halo {
    0%,
    100% {
      opacity: 0.45;
      transform: translate(-50%, -50%) scale(0.85);
    }
    50% {
      opacity: 0.95;
      transform: translate(-50%, -50%) scale(1.12);
    }
  }

  /* La celda del calendario es pequena (~28px en movil). Este pseudo invisible
     lleva el area tactil al minimo de 44px sin agrandar el circulo. */
  .day-button::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: max(100%, 44px);
    height: max(100%, 44px);
    border-radius: 9999px;
  }

  /* Anillo que late. Antes se animaba box-shadow, que repinta en cada frame;
     ahora es un pseudo que solo escala y varia opacidad, y eso lo resuelve el
     compositor sin repintar. */
  .day-button::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 2px solid color-mix(in srgb, var(--color-accent) 60%, transparent);
    animation: day-pulse 2.4s ease-in-out infinite;
    pointer-events: none;
  }

  .day-button:hover::after,
  .day-button:focus-visible::after {
    animation-play-state: paused;
  }

  @keyframes day-pulse {
    0%,
    100% {
      opacity: 0.7;
      transform: scale(1);
    }
    50% {
      opacity: 0;
      transform: scale(1.9);
    }
  }

  .sparkle {
    position: absolute;
    z-index: 2;
    width: 14px;
    height: 14px;
    pointer-events: none;
    opacity: 0;
    /* Color del boton, no el de detalle: sobre el fondo lila claro el tono
       claro no se distinguia. */
    background: var(--color-accent);
    clip-path: polygon(
      50% 0%,
      58% 42%,
      100% 50%,
      58% 58%,
      50% 100%,
      42% 58%,
      0% 50%,
      42% 42%
    );
    animation: sparkle-twinkle 2.4s ease-in-out infinite;
  }

  .sparkle--1 {
    top: -11px;
    right: -7px;
    animation-delay: 0s;
  }

  .sparkle--2 {
    bottom: -9px;
    left: -11px;
    width: 12px;
    height: 12px;
    animation-delay: 0.5s;
  }

  .sparkle--3 {
    top: 30%;
    right: -15px;
    width: 10px;
    height: 10px;
    animation-delay: 1s;
  }

  .sparkle--4 {
    top: -8px;
    left: -10px;
    width: 9px;
    height: 9px;
    animation-delay: 1.5s;
  }

  .sparkle--5 {
    bottom: -13px;
    right: 25%;
    width: 11px;
    height: 11px;
    animation-delay: 0.8s;
  }

  @keyframes sparkle-twinkle {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.3) rotate(0deg);
    }
    15% {
      opacity: 1;
      transform: scale(1.15) rotate(35deg);
    }
    35% {
      opacity: 0.85;
      transform: scale(0.95) rotate(70deg);
    }
    60% {
      opacity: 0;
      transform: scale(0.4) rotate(110deg);
    }
  }

  .calendar-hint {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-baskervville);
    font-size: clamp(11px, 3vw, 14px);
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Quien pide menos movimiento no ve la animacion, pero el boton sigue ahi. */
  @media (prefers-reduced-motion: reduce) {
    .day-button {
      background-image: none;
      background-color: var(--color-accent);
    }

    .day-button::after {
      animation: none;
      opacity: 0.8;
      transform: scale(1.25);
    }

    .day-slot::before {
      animation: none;
      opacity: 0.7;
    }

    .sparkle {
      animation: none;
      opacity: 0.85;
      transform: scale(1);
    }
  }
</style>

<script>
  const isAndroid = () => /android/i.test(navigator.userAgent);

  const addToCalendar = (googleUrl: string) => {
    if (isAndroid()) {
      // En Android, Google Calendar es la app por defecto y este enlace la
      // abre con el evento ya rellenado.
      window.open(googleUrl, "_blank", "noopener");
      return;
    }
    // iOS (y escritorio): Safari reconoce el .ics y ofrece anadirlo a Calendario.
    window.location.href = "/evento.ics";
  };

  document.querySelectorAll<HTMLElement>("[data-google-url]").forEach((el) => {
    el.addEventListener("click", () => addToCalendar(el.dataset.googleUrl ?? ""));
  });
</script>
