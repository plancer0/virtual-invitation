---
import "../styles/global.css";
import "../components/frame/frame.component.astro";
import Frame from "../components/frame/frame.component.astro";
import Title from "../components/Title/title.component.astro";
import { Font } from "astro:assets";
import { Image } from "astro:assets";
import CalendarComponent from "../components/calendar/calendar.component.astro";
import CountdownComponent from "../components/countdown/countdown.component.astro";
import PolaroidPair from "../components/polaroid-pair/polaroid-pair.component.astro";
import InfoCube from "../components/info-cube/info-cube.component.astro";
import MapModal from "../components/map-modal/map-modal.component.astro";
import GeoDecor from "../components/geo-decor/geo-decor.component.astro";
import SideDecor from "../components/side-decor/side-decor.component.astro";
import CubeDecor from "../components/cube-decor/cube-decor.component.astro";
import RsvpButton from "../components/rsvp-button/rsvp-button.component.astro";
import MusicPlayer from "../components/music-player/music-player.component.astro";
import corona from "../Images/corona_morada_svg_exacta.svg";
import decor from "../Images/decor.png";
import saco from "../Images/saco.png";
import vestido from "../Images/vestido.png";
import { DISPLAY_DATE } from "../lib/event";

const date = DISPLAY_DATE;
const quinceaneraName = "Rachell";
const parentsNames = "Ronald y Mildred";

const venueName = "Chalet la Rioja";
const venueQuery = encodeURIComponent(`${venueName}, Amatitlán, Guatemala`);
const venueLat = 14.452510771339947;
const venueLng = -90.5618720207432;

const googleMapsUrl = "https://maps.app.goo.gl/pmV3aJcxpxYGNmWp9";
const appleMapsUrl = "https://maps.apple/p/77-YP_gU.WBj7A";
const wazeUrl = "https://waze.com/ul/h9fxd5nyz3";
const uberMapsUrl = `https://m.uber.com/ul/?action=setPickup&dropoff[latitude]=${venueLat}&dropoff[longitude]=${venueLng}&dropoff[formatted_address]=${venueQuery}&dropoff[nickname]=${encodeURIComponent(venueName)}`;

const dressCodeType = "Gala";
const dressCodeColor = "Morado";
const dressCodeColorHex = "#8D6FAE";

const rsvpDeadline = new Date(date.getTime() - 14 * 24 * 60 * 60 * 1000);
const rsvpDeadlineLabel = rsvpDeadline.toLocaleDateString("es-ES", {
  day: "numeric",
  month: "long",
});

const rsvpPhoneNumber = "50242432127";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--baskervville" preload />
    <Font cssVariable="--baskervville-sc" preload />

    <Font cssVariable="--meaculpa" preload />

    <title>Invitacion de Rachell</title>
  </head>
  <body>
    <Frame width="min(750px, 100%)" border="3px solid #8D6FAE" padding="2px">
      <Frame
        padding="clamp(20px, 8vw, 85px)"
        gap="clamp(20px, 4vw, 36px)"
        border="none"
        class="justify-center items-center"
      >
        <div class="reveal flex w-full flex-col items-center gap-3 px-[clamp(16px,6vw,58px)]">
          <Title
            fontSize="clamp(28px, 7vw, 40px)"
            class="flex items-stretch justify-center gap-[clamp(8px,2.5vw,16px)] pt-[clamp(62px,17.5vw,90px)]"
          >
            <span
              class="flex items-start leading-none font-meaculpa text-[clamp(20px,5.2vw,30px)] mt-[clamp(18px,5.5vw,35px)]"
              >Mis</span
            >
            <span
              class="relative font-baskervville-sc text-[#8D6FAE] text-[clamp(72px,22vw,190px)] leading-[0.85]"
            >
              <Image
                src={corona}
                width={1774}
                height={887}
                alt="Corona decorativa"
                class="absolute bottom-full left-1/2 -translate-x-1/2 mb-[-0.1em] w-[clamp(130px,34vw,200px)] max-w-none h-auto"
              />
              15
            </span>
            <span
              class="flex items-end font-meaculpa leading-none text-[clamp(20px,5.2vw,30px)] mb-[clamp(5px,1.6vw,10px)]"
              >años</span
            >
          </Title>
          <p class="font-baskervville text-[#403848] text-[clamp(14px,4vw,18px)] text-center max-w-[46ch]">
            Hay momentos que se guardan para siempre, y este es uno de ellos. Acompáñame a
            celebrar mis quince rodeada de las personas que más quiero, y hagamos de esta
            noche un recuerdo inolvidable.
          </p>
        </div>

        <div
          class="reveal relative flex w-full flex-col items-center gap-6 px-[clamp(16px,6vw,58px)]"
          style="--out: calc(-1 * (clamp(20px, 8vw, 85px) + 21px));"
        >
          <!-- Ramas laterales, detras de las fotos. El desplazamiento es el
               padding del Frame mas el del body: en movil eso deja el borde de
               la rama justo en el filo de la pantalla. Se evita 50vw a
               proposito, porque incluye la barra de scroll y provocaba
               desbordamiento horizontal en escritorio. -->
          <!-- La rotacion va en el contenedor, con el pivote en la esquina
               inferior, para que la rama parezca brotar de ahi. El reflejo se
               queda en la imagen: si ambos compartieran elemento, el volteo
               moveria el punto de giro. La base se sale de la pantalla a
               proposito; el recorte lo hace html/body en global.css. -->
          <div
            class="pointer-events-none absolute bottom-[8%] w-[clamp(130px,34vw,260px)] origin-bottom-left rotate-[26deg]"
            style="left: calc(var(--out) - 28%);"
          >
            <SideDecor class="block w-full h-auto" />
          </div>
          <div
            class="pointer-events-none absolute bottom-[8%] w-[clamp(130px,34vw,260px)] origin-bottom-right rotate-[-26deg]"
            style="right: calc(var(--out) - 28%);"
          >
            <SideDecor flip class="block w-full h-auto" />
          </div>
          <Title
            fontSize="clamp(48px, 16vw, 128px)"
            fontFamily="var(--font-meaculpa)"
            color="#403848"
            class="relative"
          >
            {quinceaneraName}
          </Title>
          <PolaroidPair class="relative w-full" />
          <p class="relative font-baskervville text-[#403848] text-[clamp(14px,4vw,18px)] text-center max-w-[46ch]">
            Hoy escribo un nuevo capítulo y quiero compartirlo contigo.
          </p>
        </div>

        <div
          class="reveal relative grid w-full"
          style="--bleed: clamp(20px, 8vw, 85px);"
        >
          <!-- El desplazamiento negativo saca el rombo del padding del Frame
               para que sus vertices laterales toquen el borde del marco. -->
          <GeoDecor
            class="pointer-events-none absolute inset-y-0 h-full"
            style="left: calc(-1 * var(--bleed)); width: calc(100% + 2 * var(--bleed));"
          />
          <!-- El padding en porcentaje se mide sobre el ancho, asi el alto de
               la seccion sale del ancho del rombo. El 1.15 la hace algo mas
               alta que ancha: es lo que deja que un rombo cuadrado asome por
               los lados sin que asomen tambien las puntas de arriba y abajo.
               Debe coincidir con la proporcion del viewBox (920/800). -->
          <div
            class="col-start-1 row-start-1"
            style="padding-top: calc((100% + 2 * var(--bleed)) * 1.15);"
          >
          </div>
          <div
            class="col-start-1 row-start-1 flex flex-col items-center justify-center gap-2 px-[clamp(16px,6vw,58px)] py-4"
          >
            <Title fontSize="clamp(24px, 6vw, 40px)">Mis padres</Title>
            <Title
              fontFamily="var(--font-meaculpa)"
              fontSize="clamp(26px, 8vw, 64px)"
              color="#8D6FAE"
            >
              {parentsNames}
            </Title>
            <div class="h-10 flex justify-center items-center w-full">
              <Image
                src={decor}
                height={40}
                alt="Decoracion"
                class="w-[clamp(130px,38vw,370px)] h-auto"
              />
            </div>
          </div>
        </div>

        <div class="reveal flex w-full flex-col items-center gap-8 px-[clamp(16px,6vw,58px)]">
          <CalendarComponent date={date} />
          <CountdownComponent date={date} />
        </div>

        <div
          class="reveal relative w-full pt-[clamp(44px,13vw,108px)] mb-[clamp(24px,6vw,48px)]"
          style="--bleed: clamp(20px, 8vw, 85px); --out: calc(-1 * (clamp(20px, 8vw, 85px) + 21px));"
        >
          <!-- Mismas ramas que en las fotos, brotando de las esquinas
               inferiores. Aqui van mas pequenas y mucho mas hundidas hacia
               fuera que en las fotos: las celdas del cubo dejan solo ~58px de
               margen lateral, asi que a mayor tamano invadian el texto. -->
          <div
            class="pointer-events-none absolute bottom-[4%] w-[clamp(100px,26vw,200px)] origin-bottom-left rotate-[26deg]"
            style="left: calc(var(--out) - 29%);"
          >
            <SideDecor class="block w-full h-auto" />
          </div>
          <div
            class="pointer-events-none absolute bottom-[4%] w-[clamp(100px,26vw,200px)] origin-bottom-right rotate-[-26deg]"
            style="right: calc(var(--out) - 45%);"
          >
            <SideDecor flip class="block w-full h-auto" />
          </div>
          <!-- El galon ocupa el pt de este bloque, sangrado hasta el borde del
               marco igual que el rombo. -->
          <CubeDecor
            class="pointer-events-none absolute top-0 h-auto"
            style="left: calc(-1 * var(--bleed)); width: calc(100% + 2 * var(--bleed));"
          />
          <InfoCube class="relative">
          <Fragment slot="a">
            <Title fontSize="clamp(20px, 5vw, 28px)">Recepción</Title>
            <p class="font-baskervville text-[#403848] text-[clamp(14px,4vw,18px)]">
              {date.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit", hour12: true })}
            </p>
            <p class="font-baskervville text-[#403848] text-[clamp(14px,4vw,18px)]">
              {venueName}
            </p>
            <MapModal
              googleMapsUrl={googleMapsUrl}
              appleMapsUrl={appleMapsUrl}
              wazeUrl={wazeUrl}
              uberUrl={uberMapsUrl}
            />
          </Fragment>

          <Fragment slot="b">
            <div class="flex flex-wrap items-center justify-center gap-[clamp(8px,2.5vw,14px)]">
              <div
                class="relative shrink-0"
                style="--dc-img: clamp(40px, 13vw, 58px); --dc-lift: clamp(5px, 1.6vw, 9px); --dc-overlap: clamp(10px, 3.2vw, 15px); width: calc(var(--dc-img) * 2 - var(--dc-overlap)); height: calc(var(--dc-img) * 1.076 + var(--dc-lift));"
              >
                <Image
                  src={vestido}
                  width={250}
                  height={269}
                  alt="Vestido de gala"
                  class="absolute left-0 bottom-0 w-[var(--dc-img)] h-auto max-w-none"
                />
                <Image
                  src={saco}
                  width={250}
                  height={269}
                  alt="Saco de gala"
                  class="absolute right-0 top-0 w-[var(--dc-img)] h-auto max-w-none"
                />
              </div>
              <div class="flex flex-col items-center gap-1 flex-1 min-w-[105px]">
                <Title fontSize="clamp(18px, 4.6vw, 24px)">{dressCodeType}</Title>
                <p class="font-baskervville text-[#403848] text-[clamp(13px,3.6vw,16px)]">
                  Color reservado: <span class="font-semibold" style={`color:${dressCodeColorHex}`}
                    >{dressCodeColor}</span
                  >
                </p>
              </div>
            </div>
          </Fragment>

          <Fragment slot="c">
            <Title fontSize="clamp(20px, 5vw, 28px)">Confirmación de asistencia</Title>
            <p class="font-baskervville text-[#403848] text-[clamp(13px,3.6vw,16px)]">
              Por favor confirma tu asistencia antes del {rsvpDeadlineLabel}.
            </p>
            <RsvpButton phoneNumber={rsvpPhoneNumber} fixed={false} class="mt-1" />
          </Fragment>

          <Fragment slot="d">
            <Title fontSize="clamp(20px, 5vw, 28px)">Sugerencia de regalo</Title>
            <p class="font-baskervville text-[#403848] text-[clamp(13px,3.6vw,16px)]">
              Si deseas obsequiarnos algo, un sobre será muy bien recibido.
            </p>
            <div class="flex gap-4 mt-1">
              <svg viewBox="0 0 24 24" class="w-[clamp(24px,7vw,32px)] h-[clamp(24px,7vw,32px)]" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="9" width="18" height="12" rx="1.5" stroke="#8D6FAE" stroke-width="1.5" />
                <path d="M3 13H21" stroke="#8D6FAE" stroke-width="1.5" />
                <path d="M12 9V21" stroke="#8D6FAE" stroke-width="1.5" />
                <path d="M12 9C12 9 8 9 8 6C8 4.5 9.2 3.5 10.5 3.5C12 3.5 12 6 12 9Z" stroke="#8D6FAE" stroke-width="1.5" stroke-linejoin="round" />
                <path d="M12 9C12 9 16 9 16 6C16 4.5 14.8 3.5 13.5 3.5C12 3.5 12 6 12 9Z" stroke="#8D6FAE" stroke-width="1.5" stroke-linejoin="round" />
              </svg>
              <svg viewBox="0 0 24 24" class="w-[clamp(24px,7vw,32px)] h-[clamp(24px,7vw,32px)]" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2.5" y="5" width="19" height="14" rx="1.5" stroke="#8D6FAE" stroke-width="1.5" />
                <path d="M3 6L12 13L21 6" stroke="#8D6FAE" stroke-width="1.5" stroke-linejoin="round" />
              </svg>
            </div>
          </Fragment>
          </InfoCube>
        </div>

        <div class="reveal flex w-full flex-col items-center gap-1 px-[clamp(16px,6vw,58px)]">
          <Title
            fontFamily="var(--font-meaculpa)"
            fontSize="clamp(40px, 11vw, 88px)"
            color="#8D6FAE"
          >
            Te esperamos
          </Title>
          <p class="font-baskervville text-[#403848] text-[clamp(15px,4.2vw,20px)] text-center">
            y puto el que lo lea
          </p>
        </div>
      </Frame>
    </Frame>
    <MusicPlayer />

    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      gsap.utils.toArray<HTMLElement>(".reveal").forEach((el) => {
        gsap.from(el, {
          opacity: 0,
          y: 28,
          duration: 0.9,
          ease: "power2.out",
          clearProps: "transform",
          scrollTrigger: {
            trigger: el,
            start: "top 88%",
            once: true,
          },
        });
      });
    </script>
  </body>
</html>
