---
import BaseLayout from "../layouts/base.layout.astro";
import Frame from "../components/frame/frame.component.astro";
import MusicPlayer from "../components/music-player/music-player.component.astro";
import RevealOnScroll from "../components/reveal-on-scroll/reveal-on-scroll.component.astro";
import TransitionAnchor from "../components/transition-anchor/transition-anchor.component.astro";
import HeroSection from "../components/sections/hero.section.astro";
import PhotosSection from "../components/sections/photos.section.astro";
import ParentsSection from "../components/sections/parents.section.astro";
import DateSection from "../components/sections/date.section.astro";
import DetailsSection from "../components/sections/details.section.astro";
import ClosingSection from "../components/sections/closing.section.astro";
import { invitation } from "../config/invitation";
import { FRAME_PADDING, FRAME_WIDTH } from "../lib/layout";
---

<BaseLayout title={`Invitacion de ${invitation.name}`}>
  <TransitionAnchor name="carta" />

  <Frame width={FRAME_WIDTH} border="3px solid #8D6FAE" padding="2px">
    <Frame
      padding={FRAME_PADDING}
      gap="clamp(20px, 4vw, 36px)"
      border="none"
      class="justify-center items-center"
    >
      <HeroSection intro={invitation.texts.intro} />

      <PhotosSection
        name={invitation.name}
        caption={invitation.texts.photos}
        photos={invitation.photos}
      />

      <ParentsSection parents={invitation.parents} />

      <DateSection date={invitation.date} />

      <DetailsSection
        date={invitation.date}
        venue={invitation.venue}
        dressCode={invitation.dressCode}
        rsvp={invitation.rsvp}
        giftText={invitation.texts.gift}
      />

      <ClosingSection text={invitation.texts.closing} />
    </Frame>
  </Frame>

  <MusicPlayer />
  <RevealOnScroll />
</BaseLayout>
