---
import { Image } from "astro:assets";
import Title from "../Title/title.component.astro";
import SideDecor from "../side-decor/side-decor.component.astro";
import { HERO_VARS } from "../../lib/layout";
import { asset } from "../../lib/assets";

const corona = asset("corona");

interface Props {
  /** Parrafo de bienvenida bajo el titulo. */
  intro: string;
}

const { intro } = Astro.props;
---

<div
  class="reveal relative flex w-full flex-col items-center gap-3 px-section-gutter"
  style={HERO_VARS}
>
  <!-- Rosas en las esquinas superiores. El desplazamiento vertical suma el
       padding del body, el del Frame y su borde, mas un extra para que la
       esquina quede cortada por el filo de la pantalla. -->
  <div
    class="pointer-events-none absolute w-[clamp(140px,36vw,280px)] origin-top-left rotate-[9deg]"
    style="left: calc(var(--out) - 12%); top: var(--out-top);"
  >
    <SideDecor kind="rosas" class="block w-full h-auto" />
  </div>
  <div
    class="pointer-events-none absolute w-[clamp(140px,36vw,280px)] origin-top-right rotate-[-9deg]"
    style="right: calc(var(--out) - 12%); top: var(--out-top);"
  >
    <SideDecor kind="rosas" flip class="block w-full h-auto" />
  </div>
  <Title
    size="title-alt"
    class="relative flex items-stretch justify-center gap-sm pt-hero-top"
  >
    <!-- El "Mis" sube con un margen propio para alinear su base optica con
         el "15" mucho mas grande a su lado; es un ajuste puntual de esta
         composicion, no una separacion de la escala. -->
    <span
      class="flex items-start leading-none font-meaculpa text-emphasis mt-[clamp(18px,5.5vw,35px)]"
      >Mis</span
    >
    <span class="relative font-baskervville-sc text-accent text-display leading-[0.85]">
      <Image
        src={corona}
        width={640}
        height={316}
        alt="Corona decorativa"
        class="absolute bottom-full left-1/2 -translate-x-1/2 mb-[-0.1em] w-[clamp(130px,34vw,200px)] max-w-none h-auto"
      />
      15
    </span>
    <span
      class="flex items-end font-meaculpa leading-none text-emphasis mb-2xs"
      >años</span
    >
  </Title>
  <p class="font-baskervville text-ink text-body-lg text-center max-w-[46ch]">
    {intro}
  </p>
</div>
