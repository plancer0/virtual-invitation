{
  "name": "mi-invitacion",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node node_modules/@invitacion/ui/scripts/recolor-assets.mjs --config src/config/invitation.ts && astro check && astro build",
