    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler-binding-wasm32-wasi": "0.3.2",
    "typescript": "^6.0.3"
